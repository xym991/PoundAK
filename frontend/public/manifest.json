{
  "manifest_version": 1,
  "type": "WebApp",

  "meta": {
    "name": "POUND AK",
    "author": "POUND GAMING",
    "version": "0.1.14",
    "minimum-overwolf-version": "0.160.0",
    "description": "Performance Tracker & Coach",
    "dock_button_title": "POUND AK",
    "icon": "icons/IconMouseOver.png",
    "icon_gray": "icons/IconMouseNormal.png",
    "launcher_icon": "icons/desktop-icon.ico",
    "window_icon": "icons/IconMouseOver.png"
  },

  "permissions": ["Hotkeys", "GameInfo", "notifications"],

  "data": {
    "start_window": "background",
    "url_protocol": {
      "schemes": ["pound-ak"]
    },
    "hotkeys": {},
    "protocol_override_domains": {
      "googlesyndication": "http"
    },
    "externally_connectable": {
      "matches": [
        "http://*.overwolf.com",
        "https://*.overwolf.com",
        "https://*.google-analytics.com",
        "http://*.google-analytics.com",
        "https://www.googleapis.com"
      ]
    },
    "force_browser": "user",
    "windows": {
      "background": {
        "file": "index.html",
        "background_optimization": false,
        "is_background_page": true
      },
      "desktop": {
        "file": "index.html",
        "desktop_only": true,
        "native_window": true,
        "transparent": true,
        "override_on_update": true,
        "block_top_window_navigation": true,
        "popup_blocker": true,
        "mute": true,
        "size": {
          "width": 1570,
          "height": 776
        },
        "min_size": {
          "width": 1570,
          "height": 776
        }
      },
      "in_game": {
        "file": "index.html",
        "in_game_only": true,
        "focus_game_takeover": "ReleaseOnHidden",
        "focus_game_takeover_release_hotkey": "pound_ak_app_showhide",
        "resizable": false,
        "transparent": true,
        "override_on_update": true,
        "clickthrough": true
      }
    },

    "game_targeting": {
      "type": "all"
    },
    "game_events": [24890, 21566],
    "launch_events": [
      {
        "event": "GameLaunch",
        "event_data": {
          "game_ids": [24890, 21566]
        },
        "start_minimized": true
      }
    ],
    "developer": {
      "enable_auto_refresh": true,
      "reload_delay": 1000,
      "filter": "*.*"
    }
  }
}
